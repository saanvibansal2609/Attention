      <CodeComponent name="practiceControl" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((trialType === &quot;stop&quot;)) {&amp;#10;    practiceBeepTime = 0.25;&amp;#10;} else {&amp;#10;    practiceBeepTime = 999;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if trialType == 'stop':&amp;#10;    practiceBeepTime = 0.250&amp;#10;else:&amp;#10;    practiceBeepTime = 999" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if trialType == 'go':&amp;#10;    if practiceResponse.keys:&amp;#10;        continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((trialType === &quot;go&quot;)) {&amp;#10;    if (practiceResponse.keys) {&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((trialType === &quot;stop&quot;)) {&amp;#10;    if (practiceResponse.keys) {&amp;#10;        practiceStopSuccess = 0;&amp;#10;        feedbackMessage = &quot;You responded after the beep.\n\nRemember: when you hear the beep, do not press anything.&quot;;&amp;#10;    } else {&amp;#10;        practiceStopSuccess = 1;&amp;#10;        feedbackMessage = &quot;Good! You stopped your response.&quot;;&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((practiceResponse.keys === correctAns)) {&amp;#10;        feedbackMessage = &quot;Correct!&quot;;&amp;#10;    } else {&amp;#10;        feedbackMessage = &quot;Incorrect.\n\nRemember to respond to the middle arrow.&quot;;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if trialType == 'stop':&amp;#10;    if practiceResponse.keys:&amp;#10;        practiceStopSuccess = 0&amp;#10;        feedbackMessage = &quot;You responded after the beep.\n\nRemember: when you hear the beep, do not press anything.&quot;&amp;#10;    else:&amp;#10;        practiceStopSuccess = 1&amp;#10;        feedbackMessage = &quot;Good! You stopped your response.&quot;&amp;#10;&amp;#10;else:&amp;#10;    if practiceResponse.keys == correctAns:&amp;#10;        feedbackMessage = &quot;Correct!&quot;&amp;#10;    else:&amp;#10;        feedbackMessage = &quot;Incorrect.\n\nRemember to respond to the middle arrow.&quot;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="practiceControl" valType="code" updates="None" name="name"/>
      </CodeComponent>
