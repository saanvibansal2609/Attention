      <CodeComponent name="trialControl" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="ssd_congruent = 0.250&amp;#10;ssd_incongruent = 0.250" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="ssd_congruent = 0.25;&amp;#10;ssd_incongruent = 0.25;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((trialType === &quot;stop&quot;)) {&amp;#10;    if ((congruency === &quot;congruent&quot;)) {&amp;#10;        SSD = ssd_congruent;&amp;#10;    } else {&amp;#10;        SSD = ssd_incongruent;&amp;#10;    }&amp;#10;} else {&amp;#10;    SSD = 999;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Select the appropriate staircase&amp;#10;if trialType == 'stop':&amp;#10;    if congruency == 'congruent':&amp;#10;        SSD = ssd_congruent&amp;#10;    else:&amp;#10;        SSD = ssd_incongruent&amp;#10;else:&amp;#10;    SSD = 999" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if t &gt;= 1.2:&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((t &gt;= 1.2)) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((trialType === &quot;stop&quot;)) {&amp;#10;    if (response.keys) {&amp;#10;        stopSuccess = 0;&amp;#10;    } else {&amp;#10;        stopSuccess = 1;&amp;#10;    }&amp;#10;    if ((congruency === &quot;congruent&quot;)) {&amp;#10;        if ((stopSuccess === 1)) {&amp;#10;            ssd_congruent += 0.05;&amp;#10;        } else {&amp;#10;            ssd_congruent -= 0.05;&amp;#10;        }&amp;#10;    } else {&amp;#10;        if ((stopSuccess === 1)) {&amp;#10;            ssd_incongruent += 0.05;&amp;#10;        } else {&amp;#10;            ssd_incongruent -= 0.05;&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    stopSuccess = &quot;&quot;;&amp;#10;    psychoJS.experiment.addData(&quot;SSD_used&quot;, SSD);&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;stopSuccess&quot;, stopSuccess);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Determine stop success and update the appropriate staircase.&amp;#10;if trialType == 'stop':&amp;#10;    &amp;#10;    if response.keys:&amp;#10;        stopSuccess = 0&amp;#10;    else:&amp;#10;        stopSuccess = 1&amp;#10;    &amp;#10;    if congruency == 'congruent':&amp;#10;        if stopSuccess == 1:&amp;#10;            ssd_congruent += 0.050&amp;#10;        else:&amp;#10;            ssd_congruent -= 0.050&amp;#10;    else:&amp;#10;        if stopSuccess == 1:&amp;#10;            ssd_incongruent += 0.050&amp;#10;        else:&amp;#10;            ssd_incongruent -= 0.050&amp;#10;&amp;#10;else:&amp;#10;    stopSuccess = ''&amp;#10;    thisExp.addData('SSD_used', SSD)&amp;#10;thisExp.addData('stopSuccess', stopSuccess)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trialControl" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
